    uuid tenant_id FK
    text full_name "PII, erasable"
    text licence_hash }
  DRIVER_ASSIGNMENT { bigint vehicle_id PK
    timestamptz valid_from PK
    bigint driver_id FK }
  TRIP { bigint id PK
    timestamptz started_at PK "monthly partitions"
    bigint vehicle_id FK }
  OEM_MAPPING { bigint id PK
    text oem_code
    int version
    jsonb spec
    text status }
