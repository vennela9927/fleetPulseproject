# Copy to .env to override. Every value has a development default in
# docker-compose.yml, so `docker compose up` works without this file.
# In Kubernetes these come from the secrets manager via External Secrets.

POSTGRES_PASSWORD=fleet_admin_dev
APP_DB_PASSWORD=fleet_app_dev
SERVICE_DB_PASSWORD=fleet_service_dev
CLICKHOUSE_PASSWORD=clickhouse_dev
CLICKHOUSE_API_PASSWORD=clickhouse_api_dev
KEYCLOAK_ADMIN_PASSWORD=keycloak_admin_dev
S3_ACCESS_KEY=fleets3
S3_SECRET_KEY=fleets3_dev_secret

# Simulator
SIM_VEHICLES=100000
SIM_INTERVAL_SECONDS=30

# Agent LLM (Gemini free tier). Leave empty to use the rule-based fallback.
GEMINI_API_KEY=

# API (services/api): settings are API_* environment variables, see fleetpulse_api/config.py.
# API_POSTGRES_DSN, API_REDIS_URL, API_CLICKHOUSE_URL, API_CLICKHOUSE_PASSWORD,
# API_OIDC_ISSUER, API_OIDC_JWKS_URL, API_RATE_LIMIT_PER_SECOND, API_RATE_LIMIT_BURST
